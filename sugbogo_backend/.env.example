# ============================
# Django (Required)
# ============================

# Generate a separate random secret per hosted environment; never commit it.
# With DEBUG=False, require >=50 characters, >=5 distinct characters, no
# whitespace and no django-insecure- prefix (Django's strength checks).
SECRET_KEY=
# Local development only. Omitted DEBUG defaults to False; typos fail startup.
# Hosted environments MUST explicitly set DEBUG=False.
DEBUG=True

# Comma-separated hostnames/IPs only: no scheme, port, path or leading dot.
# Add your LAN IP for phone testing when using this explicit list.
# If omitted with DEBUG=True, the existing wildcard LAN behavior is preserved.
# With DEBUG=False, a nonempty explicit list is required; all wildcards fail.
# Production example: api.example.com,api.internal
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Exact origins, comma-separated: scheme://hostname[:port], no trailing slash.
# Local default when omitted: http://localhost:5173. Production default: empty.
# Production origins must use HTTPS, e.g. https://admin.example.com.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Only needed for cross-origin CSRF-protected forms/cookie requests; independent
# of CORS. JWT bearer authentication is unchanged. Default: empty.
CSRF_TRUSTED_ORIGINS=

# When omitted: False locally, True with DEBUG=False. Session and CSRF cookies
# are always secure in production. Leave this unset to use the mode default.
# With TLS termination at a proxy, verify HTTPS detection BEFORE enabling
# Django redirects, otherwise HTTPS requests can enter a redirect loop.
# Set False only when the trusted edge enforces HTTPS and blocks direct HTTP.
# SECURE_SSL_REDIRECT=True

# Default empty: Django trusts no forwarded protocol headers. Set only after
# verifying the app is reachable only through the trusted proxy, which strips
# ALL client-supplied copies (including comma-separated values) and overwrites
# the header according to the original request scheme. Use the verified header
# name in request.META format and its secure value, separated by one comma.
# Example only, NOT an assertion about your future hosting provider:
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_PROXY_SSL_HEADER=

# Keep HSTS disabled until HTTPS/proxy handling works, then start with a short
# duration such as 300. Subdomain enforcement and preload remain disabled.
# Django --deploy warns about disabled HSTS, or subdomain/preload opt-ins when
# HSTS is enabled; review those warnings against the eventual domain setup.
SECURE_HSTS_SECONDS=0

# ============================
# Database (Required)
# ============================

# PostGIS is the default; production rejects other engines.
# All DB_* connection values must be supplied by the chosen database host.
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional libpq TLS settings; blank preserves existing local behavior.
# Production: choose verified TLS/private networking with the hosting provider.
# Prefer verify-full with the provider CA mounted read-only at DB_SSLROOTCERT.
# require encrypts but does not guarantee hostname verification. Do not disable
# verification to work around a certificate error. No Windows DLL paths needed.
DB_SSLMODE=
DB_SSLROOTCERT=

# Explorer map discovery limits (degrees per latitude/longitude axis).
MAP_DISCOVERY_MAX_MARKERS=200
MAP_DISCOVERY_MAX_VIEWPORT_SPAN=0.5

# Exact-name duplicate registration proximity threshold, in metres.
MERCHANT_DUPLICATE_RADIUS_METRES=50

# Required for deployed visibility and route-intent analytics. Use the provider's
# authenticated mongodb:// or mongodb+srv:// URI; preserve TLS verification.
# Blank URI is not a disabled mode: PyMongo can fall back to localhost.
MONGODB_URI=
MONGODB_DATABASE=sugbogo

# One Redis instance can serve both URLs below (local broker DB 0, Channels DB 1).
# Hosted URLs require credentials/private access; use verified rediss:// for TLS.
# Broker TLS example (replace host; add URL-encoded provider credentials later):
# rediss://redis.example.com:6380/0?ssl_cert_reqs=required
# See docs/cloud-services.md for persistence and certificate requirements.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Optional outside Docker; image default is 1. Increase only after measuring RAM.
# CELERY_WORKER_CONCURRENCY=1
# Bare local default: celerybeat-schedule in the current working directory.
# Image default: /var/lib/sugbogo/celerybeat-schedule. Run ONE Beat instance and
# mount persistent writable storage at /var/lib/sugbogo (owned by sugbogo).
# CELERY_BEAT_SCHEDULE_FILENAME=/var/lib/sugbogo/celerybeat-schedule

# ============================
# GeoDjango (Required)
# ============================
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# Local sentiment artifacts (absolute paths). Use existing reviewed files only;
# do not download models at API/worker startup. See docs/models-and-integrations.md.
# Linux worker examples below require a persistent read-only model mount.
# FASTTEXT_LID_MODEL_PATH=/opt/sugbogo/models/lid.176.bin
# TAGALOG_SENTIMENT_MODEL_PATH=/opt/sugbogo/models/tagalog


# ============================
# Application URLs (Required)
# ============================

# Backend
BACKEND_URL=http://localhost:8000

# Frontend
WEB_APP_URL=http://localhost:5173
MOBILE_SCHEME=com.sugbogo.app://

# Email verification and password reset URLs
EMAIL_VERIFICATION_URL=http://localhost:8000/api/auth/verify-email/
PASSWORD_RESET_URL=http://localhost:8000/api/auth/reset-password/


# ============================
# External Services
# ============================

# Required when the email service is imported (including URL checks). Configure
# a verified sender/domain for recipients outside the provider's test allowance.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# Required for the implemented media/document upload flows; no startup validation.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server key: enable the used Places, Geocoding and Routes APIs; restrict and budget.
GOOGLE_MAPS_API_KEY=

# Required for normal automated review moderation; missing key holds provider work.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Required for live daily review keyword extraction
GEMINI_API_KEY=
GEMINI_KEYWORD_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
# Gemini is the only production sentiment provider for existing and new businesses.
GEMINI_SENTIMENT_ALL_BUSINESSES=True
GEMINI_SENTIMENT_SHADOW_MODEL=gemini-3.5-flash-lite
GEMINI_SENTIMENT_SHADOW_ENABLED=False
# False pauses inference without restoring VADER/RoBERTa.
GEMINI_SENTIMENT_CUTOVER_ENABLED=True

# Merchant Plus preview: False permits premium access after normal auth/role/ownership checks.
# True requires an eligible server-side entitlement; real paid access is not implemented.
MERCHANT_PLUS_ENFORCED=False
# Demo activation/reset and demo access recognition only. Keep False outside demonstrations.
MERCHANT_PLUS_MOCK_ENABLED=False

# ============================
# OAuth (Required when exposing these login methods)
# ============================

# Required audience for Google ID-token verification; do not expose login unset.
GOOGLE_OAUTH_CLIENT_ID=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Notification WebSockets (Redis is independent of PostgreSQL inbox storage)
# May use the same Redis server as CELERY_BROKER_URL; keep both URLs configured.
NOTIFICATION_REDIS_URL=redis://127.0.0.1:6379/1
# Exact browser origins, comma-separated; native clients authenticate without Origin.
NOTIFICATION_WS_ALLOWED_ORIGINS=http://localhost:5173
# PayMongo foundation: leave checkout disabled until the checkout task is complete.
PAYMONGO_CHECKOUT_ENABLED=False
PAYMONGO_MODE=test
PAYMONGO_TEST_SECRET_KEY=
PAYMONGO_TEST_WEBHOOK_SECRET=
PAYMONGO_LIVE_SECRET_KEY=
PAYMONGO_LIVE_WEBHOOK_SECRET=
PAYMONGO_RETURN_BASE_URL=
PAYMONGO_PAYMENT_METHOD_TYPES=gcash
