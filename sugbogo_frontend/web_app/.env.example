VITE_API_URL=

# Browser key with Maps JavaScript API enabled and website restrictions.
# Restart Vite after changing these values. Never commit the real key.
VITE_GOOGLE_MAPS_API_KEY=
# JavaScript map ID (not an API key). Required for production transit maps.
# Local Vite development uses Google's DEMO_MAP_ID when this is empty.
VITE_GOOGLE_MAP_ID=
